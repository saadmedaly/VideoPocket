# Comma-separated list of origins allowed to call this API. Never use "*".
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Port the server binds to.
PORT=8200

# Optional: set this to protect the API with a simple shared token if you expose
# it on the internet. Leave empty for local network use.
ACCESS_TOKEN=

# Resource limits (seconds / bytes). Defaults are shown; override only if you
# know your hardware and bandwidth can take it.
MAX_VIDEO_DURATION=10800
MAX_DOWNLOAD_SIZE=1610612736
DOWNLOAD_TIMEOUT=2700
MAX_QUEUE_SIZE=10
DOWNLOAD_WORKERS=1
MIN_FREE_DISK_SPACE=1073741824
FILE_RETENTION_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
